<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- Built only with the profile "jcef" (root POM). -->
  <artifactId>skillroy-sample-web-host-agent</artifactId>
  <name>skillroy-sample-web-host-agent</name>
  <description>
    Agent module 'webhost': hands the agent the web host's browsers as seeds (a BrowserRegistryAdapter) and reports
    the target ready once the host has registered them.
  </description>

  <properties>
    <!-- Agent side: Java 8 language and API, no third-party dependencies. -->
    <maven.compiler.release>8</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- Everything the module compiles against is supplied at run time: the agent API (and with it the protocol) by
         the agent loader (lib/ of the agent home), the host's registry class by the host loader. Nothing is bundled,
         and the module itself names no JCEF type. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-sample-web-host</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
