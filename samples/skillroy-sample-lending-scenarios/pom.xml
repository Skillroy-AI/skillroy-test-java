<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-sample-lending-scenarios</artifactId>
  <name>skillroy-sample-lending-scenarios</name>
  <description>
    Scenarios against the sample lending desk, their committed plans, and the end-to-end tests in all load modes.
  </description>

  <properties>
    <!-- Controller side: Java 25. -->
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Where the end-to-end tests find the agent home and the target's class path (assembled below). -->
    <skillroy.it.agentHome>${project.build.directory}/skillroy-agent</skillroy.it.agentHome>
    <skillroy.it.targetLib>${project.build.directory}/it-target</skillroy.it.targetLib>
    <!-- The assembled launcher of the reactor's CLI module, and the lending pack jar it is given. -->
    <skillroy.it.cliDist>${project.basedir}/../../controller/skillroy-cli/target/skillroy-cli</skillroy.it.cliDist>
    <skillroy.it.packJar>${project.build.directory}/it-cli/skillroy-sample-lending-pack.jar</skillroy.it.packJar>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-sample-lending-pack</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-junit</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-data</artifactId>
    </dependency>
    <!-- The agent home (zip); never on a class path. The exclusion keeps the agent jars the zip is assembled from
         off the test class path: the controller reaches the agent only through the agent home, as it would in a
         real installation. Declared so that the reactor builds it first. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-dist</artifactId>
      <type>zip</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- The target's jars. Copied into target/it-target and the agent home below; declared so that the reactor
         builds them first. They are not used on the controller's class path. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-sample-lending-app</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-sample-lending-agent</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The assembled command-line launcher (controller/skillroy-cli/target/skillroy-cli) that the end-to-end checks
         run once per target Java. Declared so that the reactor builds it first; never on the class path. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-cli</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Phase 5 (phase5-contracts.md 2.1, 14): the inference layer for scenario D's tier (b) slot (its contributor is
         found through ServiceLoader in approve and live; replay never loads it), the recorded and scripted gateways,
         the session service and triage; and the MCP server with its SDK client for the end-to-end checks. Test scope
         only: nothing of it reaches the pack or a target JVM. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-inference</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-mcp</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Phase 6 (phase6-contracts.md 11.4): the overlay of the branch edition. Built before this module, kept off the
         test class path (classpathDependencyExcludes below: on it, ServiceLoader would overlay the pack of every
         standard-edition test) and handed to the tests as a jar they load in a class loader of their own
         (skillroy.it.overlayJar). -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-sample-lending-pack-branch</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Assembles what the end-to-end tests launch, after package and before the integration tests:
           target/skillroy-agent/   the agent home from the skillroy-agent-dist zip, plus the lending module in modules/
           target/it-target/        the target's class path: the lending application, HSQLDB, and (for EMBEDDED) the
                                    lending module jar, which holds the plugin class. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- Phase 6: ${ai.skillroy:skillroy-sample-lending-pack-branch:jar}, the overlay's file, for the tests. -->
          <execution>
            <id>dependency-paths</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
          <execution>
            <id>unpack-agent-home</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.skillroy</groupId>
                  <artifactId>skillroy-agent-dist</artifactId>
                  <version>${project.version}</version>
                  <type>zip</type>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                </artifactItem>
              </artifactItems>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
          <execution>
            <id>lending-module-into-agent-home</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.skillroy</groupId>
                  <artifactId>skillroy-sample-lending-agent</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${skillroy.it.agentHome}/modules</outputDirectory>
                  <destFileName>skillroy-sample-lending-agent.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
          <execution>
            <id>lending-pack-for-the-launcher</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.skillroy</groupId>
                  <artifactId>skillroy-sample-lending-pack</artifactId>
                  <version>${project.version}</version>
                  <destFileName>skillroy-sample-lending-pack.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/it-cli</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
          <execution>
            <id>target-class-path</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.skillroy</groupId>
                  <artifactId>skillroy-sample-lending-app</artifactId>
                  <version>${project.version}</version>
                  <destFileName>skillroy-sample-lending-app.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.hsqldb</groupId>
                  <artifactId>hsqldb</artifactId>
                  <version>${hsqldb.version}</version>
                  <classifier>jdk8</classifier>
                  <destFileName>hsqldb.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>ai.skillroy</groupId>
                  <artifactId>skillroy-sample-lending-agent</artifactId>
                  <version>${project.version}</version>
                  <destFileName>skillroy-sample-lending-agent.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${skillroy.it.targetLib}</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Executions (integration-test, verify) and argLine come from the parent's pluginManagement. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <skillroy.it.buildDir>${project.build.directory}</skillroy.it.buildDir>
            <skillroy.it.moduleDir>${project.basedir}</skillroy.it.moduleDir>
            <skillroy.it.cliDist>${skillroy.it.cliDist}</skillroy.it.cliDist>
            <skillroy.it.packJar>${skillroy.it.packJar}</skillroy.it.packJar>
            <skillroy.it.overlayJar>${ai.skillroy:skillroy-sample-lending-pack-branch:jar}</skillroy.it.overlayJar>
          </systemPropertyVariables>
          <classpathDependencyExcludes>
            <classpathDependencyExclude>ai.skillroy:skillroy-sample-lending-pack-branch</classpathDependencyExclude>
          </classpathDependencyExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <skillroy.it.moduleDir>${project.basedir}</skillroy.it.moduleDir>
            <skillroy.it.overlayJar>${ai.skillroy:skillroy-sample-lending-pack-branch:jar}</skillroy.it.overlayJar>
          </systemPropertyVariables>
          <classpathDependencyExcludes>
            <classpathDependencyExclude>ai.skillroy:skillroy-sample-lending-pack-branch</classpathDependencyExclude>
          </classpathDependencyExcludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
