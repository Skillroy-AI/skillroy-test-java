{
  "planVersion": 7,
  "scenarioId": "return-over-limit-needs-supervisor",
  "pack": "lending",
  "packVersion": "0.6.0",
  "sourceHash": "sha256:a90c88c3351dd6c604b49122d37f572b13ad3b4ab96da3297536136126709518",
  "inference": "none",
  "requires": [
    "lending.input",
    "lending.state",
    "lending.loan",
    "lending.loan.authorisations",
    "lending.prompt",
    "lending.prompt.answer",
    "lending.slip",
    "lending.access.check",
    "lending.deposit",
    "lending.limits",
    "swing.tree"
  ],
  "slots": [
    {
      "name": "systemMax",
      "kind": "query",
      "query": "SystemLimit",
      "args": {
        "type": "RETURN"
      },
      "verify": [
        "lending.limits"
      ]
    },
    {
      "name": "item",
      "kind": "query",
      "query": "LendableItem",
      "args": {
        "deposit": {
          "between": [
            "20.00",
            "200.00"
          ],
          "lte": "$systemMax"
        }
      },
      "strategy": [
        "sql"
      ],
      "verify": [
        "lending.deposit"
      ]
    },
    {
      "name": "assistant",
      "kind": "query",
      "query": "StaffWithPermission",
      "args": {
        "interactiveSignOn": true,
        "limit": {
          "lt": "$item.deposit",
          "type": "RETURN"
        },
        "perform": [
          "SIGN_ON",
          "RETURN"
        ]
      },
      "verify": [
        "lending.access.check"
      ],
      "credential": {
        "realm": "staff",
        "key": "code"
      }
    },
    {
      "name": "supervisor",
      "kind": "query",
      "query": "StaffWithPermission",
      "args": {
        "distinctFrom": [
          "$assistant.code"
        ],
        "limit": {
          "gte": "$item.deposit",
          "type": "RETURN"
        },
        "perform": [
          "RETURN_OVERRIDE"
        ]
      },
      "verify": [
        "lending.access.check"
      ],
      "credential": {
        "realm": "staff",
        "key": "code"
      }
    },
    {
      "name": "keys",
      "kind": "query",
      "query": "ActionKey",
      "args": {
        "actions": [
          "RETURN",
          "DUE"
        ]
      },
      "verify": [
        "swing.find"
      ]
    },
    {
      "name": "loan",
      "kind": "capture",
      "step": "s12",
      "fields": [
        "id",
        "total"
      ]
    }
  ],
  "oracles": [
    {
      "name": "auth",
      "fn": "ExpectedAuthorisation",
      "args": {
        "amount": "$item.deposit",
        "staffLimit": "$assistant.limits.RETURN",
        "systemMax": "$systemMax"
      },
      "mustEqual": "SUPERVISOR_PROMPT"
    },
    {
      "name": "returnLine",
      "fn": "Money.negate",
      "args": [
        "$item.deposit"
      ]
    }
  ],
  "resolutionGraph": [
    "systemMax",
