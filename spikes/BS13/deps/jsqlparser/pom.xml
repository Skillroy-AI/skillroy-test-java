<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spike BS13, item 11: resolves the JSqlParser set of Phase 5 into the local Maven cache and prints its tree
       ("mvn -f spikes/BS13/deps/jsqlparser/pom.xml dependency:tree"). Builds nothing. -->
  <groupId>ai.skillroy.spikes</groupId>
  <artifactId>skillroy-spike-bs13-deps-jsqlparser</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <!-- The latest 5.4.x on Maven Central on 2026-10-07 (the 5.4 line has no patch release). -->
    <jsqlparser.version>5.4</jsqlparser.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.github.jsqlparser</groupId>
      <artifactId>jsqlparser</artifactId>
      <version>${jsqlparser.version}</version>
    </dependency>
  </dependencies>
</project>
