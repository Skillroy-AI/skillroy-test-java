<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spike BS13, item 11: a simulation of the CLI distribution's class path after Phase 5 (the Jackson set that
       skillroy-data declares, managed as the root POM manages it, then the three Phase 5 sets in the order the CLI
       would reach them), to see which versions Maven's mediation picks when the sets meet. Without a profile it
       manages Jackson as the root POM does today (jackson-databind and jackson-dataformat-yaml only); with
       -Pjackson-bom it imports jackson-bom instead, which aligns every Jackson module. Builds nothing:
       "mvn -f spikes/BS13/deps/cli-classpath/pom.xml dependency:list" (add -Pjackson-bom to compare). -->
  <groupId>ai.skillroy.spikes</groupId>
  <artifactId>skillroy-spike-bs13-deps-cli-classpath</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <!-- As in the root POM. -->
    <jackson.version>2.22.3</jackson.version>
  </properties>

  <profiles>
    <profile>
      <id>root-pom-management</id>
      <activation>
        <property>
          <name>!jackson-bom-placeholder-never-set</name>
        </property>
      </activation>
      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
          </dependency>
          <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
          </dependency>
        </dependencies>
      </dependencyManagement>
    </profile>
    <profile>
      <id>jackson-bom</id>
      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>com.fasterxml.jackson</groupId>
            <artifactId>jackson-bom</artifactId>
            <version>${jackson.version}</version>
            <type>pom</type>
            <scope>import</scope>
          </dependency>
        </dependencies>
      </dependencyManagement>
    </profile>
  </profiles>

  <dependencies>
    <!-- What skillroy-data declares (the CLI reaches it first). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- skillroy-inference -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>2.34.0</version>
    </dependency>
    <dependency>
      <groupId>com.github.jsqlparser</groupId>
      <artifactId>jsqlparser</artifactId>
      <version>5.4</version>
    </dependency>
    <!-- skillroy-mcp -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
      <version>2.0.1</version>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson2</artifactId>
      <version>2.0.1</version>
    </dependency>
  </dependencies>
</project>
