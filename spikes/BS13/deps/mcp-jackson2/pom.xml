<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spike BS13, item 11: resolves the MCP Java SDK 2.0.1 as its core plus the Jackson 2 JSON module (the set that
       shares Jackson 2 with the Anthropic SDK) into the local Maven cache and prints its tree
       ("mvn -f spikes/BS13/deps/mcp-jackson2/pom.xml dependency:tree"). Builds nothing. -->
  <groupId>ai.skillroy.spikes</groupId>
  <artifactId>skillroy-spike-bs13-deps-mcp-jackson2</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <mcp.version>2.0.1</mcp.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
      <version>${mcp.version}</version>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson2</artifactId>
      <version>${mcp.version}</version>
    </dependency>
  </dependencies>
</project>
