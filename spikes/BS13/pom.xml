<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spike BS13: checks, live and once, the Claude API facts that the Phase 5 contract (docs/design/phase5-contracts.md)
       relies on, through the Anthropic Java SDK version the contract pins. Not a reactor module: build it with
       "mvn -f spikes/BS13/pom.xml package" and run it as README.md says (it needs ANTHROPIC_API_KEY in the environment
       and never reads a key from anywhere else). The result is written up in RESULT.md next to this file. The two
       POMs under deps/ only resolve the other Phase 5 dependency sets for the licence audit. -->
  <groupId>ai.skillroy.spikes</groupId>
  <artifactId>skillroy-spike-bs13</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>skillroy-spike-bs13</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- The version phase5-contracts.md 2.2 pins (ai-inference F12, R7); override with -Danthropic-java.version=... -->
    <anthropic-java.version>2.34.0</anthropic-java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>${anthropic-java.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>bs13-probe</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>25</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>ai.skillroy.testjava.spikes.bs13.Bs13Probe</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- target/lib: the run-time class path of the probe. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>copy-runtime-class-path</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
