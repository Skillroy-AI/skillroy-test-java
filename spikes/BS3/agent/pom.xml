<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.skillroy.spikes</groupId>
    <artifactId>skillroy-spike-bs3</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- The probe agent jar, target/bs3/bs3-agent.jar: the shape of skillroy-agent-bootstrap, small. It depends on
       nothing; the engine and spy jars are found next to it. -->
  <artifactId>skillroy-spike-bs3-agent</artifactId>
  <name>skillroy-spike-bs3-agent</name>

  <properties>
    <bs3.agent.class>ai.skillroy.testjava.spikes.bs3.agent.ProbeAgent</bs3.agent.class>
  </properties>

  <build>
    <finalName>bs3-agent</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <outputDirectory>${bs3.dist}</outputDirectory>
          <archive>
            <manifestEntries>
              <Premain-Class>${bs3.agent.class}</Premain-Class>
              <Agent-Class>${bs3.agent.class}</Agent-Class>
              <Can-Retransform-Classes>true</Can-Retransform-Classes>
              <Can-Redefine-Classes>true</Can-Redefine-Classes>
              <Can-Set-Native-Method-Prefix>true</Can-Set-Native-Method-Prefix>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
