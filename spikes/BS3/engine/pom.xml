<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.skillroy.spikes</groupId>
    <artifactId>skillroy-spike-bs3</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- The hook engine (the prototype of skillroy-agent-hooks) and the probe script that exercises it. It runs in the
       agent's isolated, child-first loader and carries Byte Buddy shaded. Three jars come out of one build:
         target/bs3/bs3-engine.jar              Byte Buddy relocated under ai.skillroy.testjava.spikes.bs3.shaded
         target/bs3/bs3-engine-javaspy.jar      the same, and the Spy references relocated to the java.* placement
         target/bs3/bs3-engine-unrelocated.jar  the control: Byte Buddy shaded in but NOT relocated (BS3 item 2)
       Spy itself is "provided": it is never inside an engine jar, it comes from the bootstrap loader. -->
  <artifactId>skillroy-spike-bs3-engine</artifactId>
  <name>skillroy-spike-bs3-engine</name>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy.spikes</groupId>
      <artifactId>skillroy-spike-bs3-spy</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>${bytebuddy.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>bs3-engine-classes</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <!-- What is dropped from Byte Buddy's jar, and why (RESULT.md, "Shading"):
               - META-INF/versions/9/module-info.class: it would declare a module named net.bytebuddy inside a jar
                 whose packages are all renamed; the engine jar is never on a module path.
               - META-INF/maven/**: Byte Buddy's own POM coordinates, which are not this jar's.
               Kept: META-INF/LICENSE and META-INF/NOTICE (Apache-2.0, and the ASM notice), and every other
               META-INF/versions/N entry, relocated (the manifest keeps Multi-Release: true). -->
          <filters>
            <filter>
              <artifact>net.bytebuddy:byte-buddy</artifact>
              <excludes>
                <exclude>META-INF/versions/*/module-info.class</exclude>
                <exclude>module-info.class</exclude>
                <exclude>META-INF/maven/**</exclude>
              </excludes>
            </filter>
            <filter>
              <artifact>ai.skillroy.spikes:*</artifact>
              <excludes>
                <exclude>META-INF/maven/**</exclude>
              </excludes>
            </filter>
          </filters>
          <transformers>
            <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
              <manifestEntries>
                <Multi-Release>true</Multi-Release>
                <Implementation-Title>skillroy-spike-bs3-engine</Implementation-Title>
                <Bs3-Byte-Buddy-Version>${bytebuddy.version}</Bs3-Byte-Buddy-Version>
              </manifestEntries>
            </transformer>
          </transformers>
        </configuration>
        <executions>
          <execution>
            <id>relocated</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${bs3.dist}/bs3-engine.jar</outputFile>
              <relocations>
                <relocation>
                  <pattern>net.bytebuddy</pattern>
                  <shadedPattern>ai.skillroy.testjava.spikes.bs3.shaded.bytebuddy</shadedPattern>
                </relocation>
                <relocation>
                  <!-- Byte Buddy's optional ClassInjector.UsingJna references com.sun.jna; renamed to a package that
                       exists nowhere, so the shaded copy can never bind to a JNA the host ships (BS3 item 2). -->
                  <pattern>com.sun.jna</pattern>
                  <shadedPattern>ai.skillroy.testjava.spikes.bs3.shaded.absent.jna</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
          <execution>
            <id>relocated-javaspy</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${bs3.dist}/bs3-engine-javaspy.jar</outputFile>
              <relocations>
                <relocation>
                  <pattern>net.bytebuddy</pattern>
                  <shadedPattern>ai.skillroy.testjava.spikes.bs3.shaded.bytebuddy</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>com.sun.jna</pattern>
                  <shadedPattern>ai.skillroy.testjava.spikes.bs3.shaded.absent.jna</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>ai.skillroy.testjava.spikes.bs3.spy</pattern>
                  <shadedPattern>java.ai.skillroy.testjava.spikes.bs3.spy</shadedPattern>
                </relocation>
              </relocations>
            </configuration>
          </execution>
          <execution>
            <id>unrelocated</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${bs3.dist}/bs3-engine-unrelocated.jar</outputFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
