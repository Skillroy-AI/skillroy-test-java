<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.skillroy.spikes</groupId>
    <artifactId>skillroy-spike-bs3</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- BS3 item 2: a host that ships older copies of the same libraries on its own class path. This module is the host
       code that uses them (target/bs3/hostlibs/bs3-hostlibs.jar), compiled against Byte Buddy 1.12.19 (the copy
       Mockito 4.11 bundles), ASM 5.0.3 and JNA 4.5.2; the three jars are copied next to it. -->
  <artifactId>skillroy-spike-bs3-hostlibs</artifactId>
  <name>skillroy-spike-bs3-hostlibs</name>

  <dependencies>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>${host.bytebuddy.version}</version>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <version>${host.asm.version}</version>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>${host.jna.version}</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>bs3-hostlibs</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <outputDirectory>${bs3.dist}/hostlibs</outputDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>old-libraries</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${bs3.dist}/hostlibs</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
