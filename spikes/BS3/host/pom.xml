<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.skillroy.spikes</groupId>
    <artifactId>skillroy-spike-bs3</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- The host program, target/bs3/bs3-host.jar: a driver main around the sample lending desk (its AccessControl on an
       in-memory database of seed A) and the toy loaders, plus the attach client. Its class path at run time is
       bs3-host.jar, the sample's jar and HSQLDB (copied to target/bs3/lib/), and in the item 2 runs the old libraries
       of target/bs3/hostlibs/. -->
  <artifactId>skillroy-spike-bs3-host</artifactId>
  <name>skillroy-spike-bs3-host</name>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-sample-lending-app</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>system</scope>
      <systemPath>${bs3.sample.jar}</systemPath>
    </dependency>
    <dependency>
      <groupId>org.hsqldb</groupId>
      <artifactId>hsqldb</artifactId>
      <version>${hsqldb.version}</version>
      <classifier>jdk8</classifier>
    </dependency>
  </dependencies>

  <build>
    <finalName>bs3-host</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <outputDirectory>${bs3.dist}</outputDirectory>
        </configuration>
      </plugin>
      <plugin>
        <!-- The sample's jar is never installed: copy the file next to HSQLDB. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>sample-jar</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${bs3.dist}/lib</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../../../samples/skillroy-sample-lending-app/target</directory>
                  <includes>
                    <include>skillroy-sample-lending-app-0.1.0-SNAPSHOT.jar</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>host-class-path</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <outputDirectory>${bs3.dist}/lib</outputDirectory>
              <stripVersion>true</stripVersion>
              <artifactItems>
                <artifactItem>
                  <groupId>org.hsqldb</groupId>
                  <artifactId>hsqldb</artifactId>
                  <version>${hsqldb.version}</version>
                  <classifier>jdk8</classifier>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
