<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spike BS8: a JCEF host program (Java 8 bytecode) that measures what the in-process DevTools channel, the two
       rendering modes and the reflective browser enumeration do under the WM-less Xvfb of the Linux test image. Not a
       reactor module: build it with "mvn -f spikes/BS8/pom.xml package" and run it with spikes/BS8/run.sh. The result
       is written up in RESULT.md next to this file. -->
  <groupId>ai.skillroy.spikes</groupId>
  <artifactId>skillroy-spike-bs8</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>skillroy-spike-bs8</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>8</maven.compiler.release>
    <!-- jcefmaven 152.0.6 wraps java-cef 17e805a, CEF 152.0.6 and Chromium 152.0.7977.83; the natives artifact is
         versioned by that release tag, not by the jcefmaven number. -->
    <jcefmaven.version>152.0.6</jcefmaven.version>
    <jcef.tag>jcef-17e805a+cef-152.0.6+g708dc14+chromium-152.0.7977.83</jcef.tag>
    <!-- The natives platform: linux-amd64 for the project's x86-64 image, linux-arm64 for an arm64 build of the same
         image (the development machine runs x86-64 under emulation, see RESULT.md). Run "package" once per platform
         you need; both jars may sit in target/lib, jcefmaven picks the one for the running platform. -->
    <bs8.natives>linux-amd64</bs8.natives>
  </properties>

  <dependencies>
    <dependency>
      <groupId>me.friwi</groupId>
      <artifactId>jcefmaven</artifactId>
      <version>${jcefmaven.version}</version>
    </dependency>
    <!-- The Linux natives (152 MB for x86-64, 168 MB for arm64), so that nothing is downloaded at run time inside the
         image. -->
    <dependency>
      <groupId>me.friwi</groupId>
      <artifactId>jcef-natives-${bs8.natives}</artifactId>
      <version>${jcef.tag}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>bs8-probe</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>8</release>
          <compilerArgs>
            <arg>-Xlint:-options</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>ai.skillroy.testjava.spikes.bs8.Bs8Probe</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <!-- target/lib: the run-time class path of the probe inside the image. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>copy-runtime-class-path</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
