# Spike BS11, derived image skillroy-spike-bs11:fonts: the tools image plus two font packages from the distribution's
# own apt repositories (Liberation 2 and Noto core). Fontconfig's own preferences are unchanged, so this measures what
# merely installing fonts does to a capture.
#
#   docker build --platform linux/arm64 -t skillroy-spike-bs11:fonts -f spikes/BS11/images/Dockerfile.fonts spikes/BS11/images
FROM skillroy-spike-bs11:tools
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends fonts-liberation2 fonts-noto-core \
 && rm -rf /var/lib/apt/lists/*
