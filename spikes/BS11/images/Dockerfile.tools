# Spike BS11, derived image skillroy-spike-bs11:tools (from the arm64 test image, never modifying it): adds xdotool from
# the distribution's own apt repositories, so that the harness can move the desk's window on the WM-less Xvfb. xdotool
# brings no fonts; the run "arm64-j25-base" on the unmodified image is the control that the image renders the same.
#
#   docker build --platform linux/arm64 -t skillroy-spike-bs11:tools -f spikes/BS11/images/Dockerfile.tools spikes/BS11/images
FROM skillroy-test-java-ci:bs8-arm64
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xdotool \
 && rm -rf /var/lib/apt/lists/*
