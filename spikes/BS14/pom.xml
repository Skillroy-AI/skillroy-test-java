<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spike BS14: Byteman in process (phase6-contracts.md 7.2). A small aggregator of its own (not a module of the root
       reactor) whose modules prototype, small, the shapes of skillroy-agent-byteman-sys (the manager and the curated
       helper on the system class path) and skillroy-agent-byteman (the module that loads Byteman through the agent's
       own Instrumentation, by reflection only), plus a toy host. Build it with "mvn -o -f spikes/BS14/pom.xml package"
       (never install); every jar lands in target/bs14/. Run the matrix with spikes/BS14/run.sh. The result is written
       up in RESULT.md next to this file. -->
  <groupId>ai.skillroy.spikes</groupId>
  <artifactId>skillroy-spike-bs14</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>skillroy-spike-bs14</name>

  <modules>
    <module>sys</module>
    <module>probe</module>
    <module>agent</module>
    <module>toy</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Everything here runs inside a target JVM (Java 8 or Java 25), so all of it is Java 8 language and API. -->
    <maven.compiler.release>8</maven.compiler.release>
    <!-- The Byteman of phase6-contracts.md 2.2 (LGPL-2.1-or-later): provided scope for the sys jar only, nothing of it
         is copied into any jar of the spike; at run time the jar comes from the local Maven repository. -->
    <byteman.version>4.0.27</byteman.version>
    <!-- Where every jar of the spike is collected (interpolated per module: every module is a direct child). -->
    <bs14.dist>${project.basedir}/../target/bs14</bs14.dist>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jboss.byteman</groupId>
        <artifactId>byteman</artifactId>
        <version>${byteman.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>ai.skillroy.spikes</groupId>
        <artifactId>skillroy-spike-bs14-sys</artifactId>
        <version>${project.version}</version>
        <scope>provided</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <release>8</release>
            <compilerArgs>
              <arg>-Xlint:-options</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
          <configuration>
            <skip>true</skip>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
