<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.skillroy.spikes</groupId>
    <artifactId>skillroy-spike-bs14</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- The probe: the shape of skillroy-agent-byteman, small. It runs in a child-first loader of its own (as a
       module does) and reaches Byteman, RuleManager and RuleHelper by reflection only, after the two appends; its
       handler (FiredHandler) implements RuleHelper.Handler and is loaded by name after the appends. The sys jar is
       provided: it is never inside this jar. -->
  <artifactId>skillroy-spike-bs14-probe</artifactId>
  <name>skillroy-spike-bs14-probe</name>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy.spikes</groupId>
      <artifactId>skillroy-spike-bs14-sys</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>bs14-probe</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <outputDirectory>${bs14.dist}</outputDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
