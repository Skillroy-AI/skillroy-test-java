<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.skillroy.spikes</groupId>
    <artifactId>skillroy-spike-bs14</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- The project jar the module appends to the system class path (the shape of skillroy-agent-byteman-sys):
       RuleManager, the class Byteman's manager: option names, and RuleHelper, the curated helper. Compiled against
       Byteman at provided scope; both keep what Byteman hands them as Object, so that nothing of Byteman is in the jar
       and no CONSTANT_Class outside java/ and ai/skillroy/ is in its constant pool (the probe checks it). -->
  <artifactId>skillroy-spike-bs14-sys</artifactId>
  <name>skillroy-spike-bs14-sys</name>

  <dependencies>
    <dependency>
      <groupId>org.jboss.byteman</groupId>
      <artifactId>byteman</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>bs14-sys</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <outputDirectory>${bs14.dist}</outputDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
