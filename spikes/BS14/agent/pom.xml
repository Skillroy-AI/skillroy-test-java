<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ai.skillroy.spikes</groupId>
    <artifactId>skillroy-spike-bs14</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!-- The probe agent jar (-javaagent): holds the Instrumentation, waits for the toy host to be ready and runs the
       probe in its own child-first loader on a worker thread. It depends on nothing. -->
  <artifactId>skillroy-spike-bs14-agent</artifactId>
  <name>skillroy-spike-bs14-agent</name>

  <build>
    <finalName>bs14-agent</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <outputDirectory>${bs14.dist}</outputDirectory>
          <archive>
            <manifestEntries>
              <Premain-Class>ai.skillroy.testjava.spikes.bs14.agent.Bs14Agent</Premain-Class>
              <Can-Retransform-Classes>true</Can-Retransform-Classes>
              <Can-Redefine-Classes>true</Can-Redefine-Classes>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
