<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spike BS12: grounding accuracy and cost of a vision loop on the sample lending desk, with live model calls.
       Not a reactor module and never part of CI: build it with "mvn -o -f spikes/BS12/pom.xml package" and run it as
       README.md says. It compiles against the controller jars of the built CLI distribution (system scope, by path:
       nothing here goes into or comes from the local Maven repository except the Anthropic SDK the distribution
       pins), and it runs on that distribution's lib/ copied into target/lib by run.sh. -->
  <groupId>ai.skillroy.spikes</groupId>
  <artifactId>skillroy-spike-bs12</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>skillroy-spike-bs12</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- The version the CLI distribution carries (controller/skillroy-cli/target/skillroy-cli/lib). -->
    <anthropic-java.version>2.70.0</anthropic-java.version>
    <bs12.cliLib>${project.basedir}/../../controller/skillroy-cli/target/skillroy-cli/lib</bs12.cliLib>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>${anthropic-java.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-controller</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>system</scope>
      <systemPath>${bs12.cliLib}/skillroy-controller-0.1.0-SNAPSHOT.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-protocol</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>system</scope>
      <systemPath>${bs12.cliLib}/skillroy-protocol-0.1.0-SNAPSHOT.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-scenario</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>system</scope>
      <systemPath>${bs12.cliLib}/skillroy-scenario-0.1.0-SNAPSHOT.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-inference</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>system</scope>
      <systemPath>${bs12.cliLib}/skillroy-inference-0.1.0-SNAPSHOT.jar</systemPath>
    </dependency>
  </dependencies>

  <build>
    <finalName>bs12-harness</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>25</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>ai.skillroy.testjava.spikes.bs12.Bs12</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
