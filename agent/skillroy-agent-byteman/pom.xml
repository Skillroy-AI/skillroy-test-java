<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-agent-byteman</artifactId>
  <name>skillroy-agent-byteman</name>
  <description>
    Optional agent module 'byteman' (phase6-contracts.md 7): ad-hoc Byteman rules in process. It loads the user's
    Byteman jar (agent option byteman.jar) through the agent's own Instrumentation on the first confirmed rule.submit,
    with no listener, reaches the rule base through Byteman's manager: option and the project's sys jar, and serves
    rule.check, rule.submit, rule.unload and rule.list. Lands in the agent home under optional/ and loads only when
    optionalModules names it. Byteman is reached by reflection only: no compile-time dependency on it.
  </description>

  <properties>
    <!-- Agent side: Java 8 language and API, no third-party class at run time. -->
    <maven.compiler.release>8</maven.compiler.release>
    <!-- Every surefire execution below holds at least one test, so one that runs none is a defect (the Java 8 test JVM
         once ran zero tests and exited 0): it fails the build. A command-line -Dtest merges the executions and may
         leave some empty, so the profile merged-test-run turns the guard off then (fix wave, L3-F1). -->
    <skillroy.failIfNoTests>true</skillroy.failIfNoTests>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-protocol</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The handler implements RuleHelper.Handler; the sys jar is appended to the system class path at run time and
         is never inside this module's jar. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-byteman-sys</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- LGPL-2.1-or-later, test scope only (D134, docs/licence-audit.md 5): the in-process tests load it. -->
    <dependency>
      <groupId>org.jboss.byteman</groupId>
      <artifactId>byteman</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Only the version file is filtered; the service registration is copied as it is. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/byteman-module.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/byteman-module.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <!-- The paths of the sys jar and of the Byteman jar for the tests (maven-dependency-plugin:properties sets
           ${groupId:artifactId:type} to each dependency's file). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>dependency-paths</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- The test agent of phase6-contracts.md 2.3: a premain jar over target/test-classes, so that the tests that
           need an Instrumentation get one at launch (JEP 451-exempt, and it works on the -Djvm Java 8 leg). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-agent</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classesDirectory>${project.build.testOutputDirectory}</classesDirectory>
              <classifier>test-agent</classifier>
              <includes>
                <include>ai/skillroy/testjava/agent/byteman/TestAgent.class</include>
              </includes>
              <archive>
                <manifestEntries>
                  <Premain-Class>ai.skillroy.testjava.agent.byteman.TestAgent</Premain-Class>
                  <Can-Retransform-Classes>true</Can-Retransform-Classes>
                  <Can-Redefine-Classes>true</Can-Redefine-Classes>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The argLine extends the inherited line (phase6-contracts.md 2.3); no module POM sets
           skillroy.test.extraArgLine. Five test classes need a JVM of their own: ProbeTest sets Byteman's "loaded"
           property, CheckLoadsNothingTest needs a JVM where nothing of Byteman was ever loaded, and InProcessRouteTest,
           LoadUndoTest and DetachBudgetTest leave Byteman loaded for the JVM's life (Byteman cannot be unloaded, and a cut-short
           detach keeps its rule base); each runs in an execution of its own (a fork per execution; reuseForks=false
           gave no tests on the Java 8 test JVM). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <failIfNoTests>${skillroy.failIfNoTests}</failIfNoTests>
          <argLine>-Djava.awt.headless=${skillroy.headless} ${skillroy.test.extraArgLine} -javaagent:${project.build.directory}/${project.build.finalName}-test-agent.jar</argLine>
          <systemPropertyVariables>
            <skillroy.test.bytemanJar>${org.jboss.byteman:byteman:jar}</skillroy.test.bytemanJar>
            <skillroy.test.sysJar>${ai.skillroy:skillroy-agent-byteman-sys:jar}</skillroy.test.sysJar>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/ProbeTest.java</exclude>
                <exclude>**/CheckLoadsNothingTest.java</exclude>
                <exclude>**/InProcessRouteTest.java</exclude>
                <exclude>**/DetachBudgetTest.java</exclude>
                <exclude>**/LoadUndoTest.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>probe</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/ProbeTest.java</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>loads-nothing</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/CheckLoadsNothingTest.java</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>in-process-route</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/InProcessRouteTest.java</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>load-undo</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/LoadUndoTest.java</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>detach-budget</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/DetachBudgetTest.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- A command-line -Dtest runs the named classes in every execution, so most executions then run nothing: no
         failure for that (the guard above is for the module's own runs). -->
    <profile>
      <id>merged-test-run</id>
      <activation>
        <property>
          <name>test</name>
        </property>
      </activation>
      <properties>
        <skillroy.failIfNoTests>false</skillroy.failIfNoTests>
      </properties>
    </profile>
  </profiles>
</project>
