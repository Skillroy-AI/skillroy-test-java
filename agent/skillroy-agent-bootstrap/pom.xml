<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-agent-bootstrap</artifactId>
  <name>skillroy-agent-bootstrap</name>
  <description>
    The -javaagent / attach jar: parses options, applies the main-class guard, builds the agent class loader and
    starts the runtime. Depends on nothing, not even the protocol module.
  </description>

  <properties>
    <!-- Agent side: Java 8 language and API, no dependencies at all. -->
    <maven.compiler.release>8</maven.compiler.release>
    <skillroy.bootstrap.class>ai.skillroy.testjava.agent.bootstrap.AgentBootstrap</skillroy.bootstrap.class>
  </properties>

  <dependencies>
    <!-- Test scope only (Phase 6 security fix, pass 2, SE): OptionsFileVolumeTest holds the bootstrap's private copy of
         the volume rule equal to the protocol's Volumes. Nothing of it reaches the bootstrap jar. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-protocol</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Premain-Class>${skillroy.bootstrap.class}</Premain-Class>
              <Agent-Class>${skillroy.bootstrap.class}</Agent-Class>
              <Launcher-Agent-Class>${skillroy.bootstrap.class}</Launcher-Agent-Class>
              <Can-Retransform-Classes>true</Can-Retransform-Classes>
              <Can-Redefine-Classes>true</Can-Redefine-Classes>
              <Can-Set-Native-Method-Prefix>true</Can-Set-Native-Method-Prefix>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
