{
  "format": 1,
  "adapter": "jcef",
  "gate": "org.cef.CefApp",
  "roles": {
    "app": {"class": "org.cef.CefApp", "for": "core"},
    "app.getState": {"class": "org.cef.CefApp", "method": "getState", "static": true, "for": "core"},
    "app.getVersion": {"class": "org.cef.CefApp", "method": "getVersion", "for": "version"},
    "app.self": {"class": "org.cef.CefApp", "field": "self", "static": true, "access": "private", "for": "walk"},
    "app.clients": {"class": "org.cef.CefApp", "field": "clients_", "access": "private", "for": "walk"},
    "app.settings": {"class": "org.cef.CefApp", "field": "settings_", "access": "private", "for": "settings"},
    "client": {"class": "org.cef.CefClient", "for": "core"},
    "client.getAllBrowser": {"class": "org.cef.CefClient", "method": "getAllBrowser", "access": "private",
      "for": "walk"},
    "browser": {"class": "org.cef.browser.CefBrowser", "for": "core"},
    "browser.getDevToolsClient": {"class": "org.cef.browser.CefBrowser", "method": "getDevToolsClient",
      "for": "devtools"},
    "browser.getIdentifier": {"class": "org.cef.browser.CefBrowser", "method": "getIdentifier", "for": "core"},
    "browser.getURL": {"class": "org.cef.browser.CefBrowser", "method": "getURL", "for": "core"},
    "browser.getUIComponent": {"class": "org.cef.browser.CefBrowser", "method": "getUIComponent", "for": "core"},
    "browser.reload": {"class": "org.cef.browser.CefBrowser", "method": "reload", "for": "reload"},
    "browser.reloadIgnoreCache": {"class": "org.cef.browser.CefBrowser", "method": "reloadIgnoreCache",
      "for": "reload"},
    "browser.windowed": {"class": "org.cef.browser.CefBrowserWr", "match": "name", "for": "rendering"},
    "browser.offscreen": {"class": "org.cef.browser.CefBrowserOsr", "match": "name", "for": "rendering"},
    "devtools": {"class": "org.cef.browser.CefDevToolsClient", "for": "devtools"},
    "devtools.execute": {"class": "org.cef.browser.CefDevToolsClient", "method": "executeDevToolsMethod",
      "params": ["java.lang.String", "java.lang.String"], "for": "devtools"},
    "devtools.addEventListener": {"class": "org.cef.browser.CefDevToolsClient", "method": "addEventListener",
      "params": ["org.cef.browser.CefDevToolsClient$EventListener"], "for": "devtools"},
    "devtools.removeEventListener": {"class": "org.cef.browser.CefDevToolsClient", "method": "removeEventListener",
      "params": ["org.cef.browser.CefDevToolsClient$EventListener"], "for": "devtools"},
    "devtools.isClosed": {"class": "org.cef.browser.CefDevToolsClient", "method": "isClosed", "for": "devtools"},
    "devtools.listener": {"class": "org.cef.browser.CefDevToolsClient$EventListener", "interface": true,
      "for": "devtools"},
    "raw.execute": {"class": "org.cef.browser.CefBrowser_N", "method": "executeDevToolsMethod",
      "params": ["java.lang.String", "java.lang.String"], "access": "private", "for": "raw"},
    "raw.addObserver": {"class": "org.cef.browser.CefBrowser_N", "method": "addDevToolsMessageObserver",
      "params": ["org.cef.browser.CefDevToolsMessageObserver"], "access": "private", "for": "raw"},
    "raw.observer": {"class": "org.cef.browser.CefDevToolsMessageObserver", "interface": true, "for": "raw"},
    "raw.dispose": {"class": "org.cef.browser.CefRegistration", "method": "dispose", "access": "private",
      "for": "raw"},
    "settings.remoteDebuggingPort": {"class": "org.cef.CefSettings", "field": "remote_debugging_port",
      "for": "settings"},
    "settings.windowless": {"class": "org.cef.CefSettings", "field": "windowless_rendering_enabled",
      "for": "settings"},
    "settings.rootCachePath": {"class": "org.cef.CefSettings", "field": "root_cache_path", "for": "cachePath"},
    "settings.cachePath": {"class": "org.cef.CefSettings", "field": "cache_path", "for": "cachePath"},
    "version.chrome": {"class": "org.cef.CefApp$CefVersion", "method": "getChromeVersion", "for": "version",
      "alternatives": [{"class": "org.cef.CefApp$CefVersion", "field": "CHROME_VERSION_MAJOR"}]}
  }
}
