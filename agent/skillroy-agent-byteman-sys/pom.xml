<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-agent-byteman-sys</artifactId>
  <name>skillroy-agent-byteman-sys</name>
  <description>
    The project jar the optional Byteman module appends to the target's system class path (phase6-contracts.md 7.3):
    RuleManager, the class Byteman's manager: option names, and RuleHelper, the curated helper a rule names. Compiled
    against Byteman at provided scope; it keeps what Byteman hands it as Object, so that nothing of Byteman is in the
    jar and its constant pool holds no CONSTANT_Class outside java/ and ai/skillroy/.
  </description>

  <properties>
    <!-- Agent side: Java 8 language and API; runs on the target's system class path. -->
    <maven.compiler.release>8</maven.compiler.release>
    <!-- A test run that runs no test is a defect (fix wave, L3-F1; see skillroy-agent-byteman's POM). -->
    <skillroy.failIfNoTests>true</skillroy.failIfNoTests>
  </properties>

  <dependencies>
    <!-- LGPL-2.1-or-later, provided scope only: the manager's initialize and the helper's constructor are declared with
         the types Byteman looks them up by; nothing of Byteman is copied into the jar (docs/licence-audit.md 5). -->
    <dependency>
      <groupId>org.jboss.byteman</groupId>
      <artifactId>byteman</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The class-file reader of the constant-pool test. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <failIfNoTests>${skillroy.failIfNoTests}</failIfNoTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- A command-line -Dtest that names no class of this module runs nothing here: no failure for that. -->
    <profile>
      <id>merged-test-run</id>
      <activation>
        <property>
          <name>test</name>
        </property>
      </activation>
      <properties>
        <skillroy.failIfNoTests>false</skillroy.failIfNoTests>
      </properties>
    </profile>
  </profiles>
</project>
