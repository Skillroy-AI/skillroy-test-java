<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-agent-core</artifactId>
  <name>skillroy-agent-core</name>
  <description>
    The agent runtime: control server, dispatcher, registries, event bus, module loader and core primitives.
  </description>

  <properties>
    <!-- Agent side: Java 8 language and API, no third-party dependencies. -->
    <maven.compiler.release>8</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-protocol</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- agent.properties carries ${project.version} for agent.info's agentVersion. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
  </build>
</project>
