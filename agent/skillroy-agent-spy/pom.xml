<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-agent-spy</artifactId>
  <name>skillroy-agent-spy</name>
  <description>
    The hooks' one class in front of the host (phase6-contracts.md 3.1): Spy with its two nested types, appended to the
    bootstrap search path by the hooks module at the first hook.install, in hooks mode only. References java.* only and
    depends on nothing, so that it links in any loader that delegates to the bootstrap loader.
  </description>

  <properties>
    <!-- Agent side: Java 8 language and API, no dependency at all. -->
    <maven.compiler.release>8</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- Tests only: the constant-pool reader for the class-file scan (the jar itself is checked by the
         distribution's HomeConstantPoolIT and by the hooks module's content check before the append). -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The jar holds Spy, its two nested classes, the manifest and the project's LICENSE and NOTICE, and nothing
           else: the hooks module refuses to append a jar with any other entry (phase6-contracts.md 3.2 step 3), so
           Maven's own descriptor (META-INF/maven/**) is left out. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <addMavenDescriptor>false</addMavenDescriptor>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <skillroy.spy.classes>${project.build.outputDirectory}</skillroy.spy.classes>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
