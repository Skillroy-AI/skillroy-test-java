<!-- Agent home layout (phase1-contracts.md 2.1), shared by the directory and zip assemblies.
     Jar names carry no version: the bootstrap must be found by a stable name. LICENSE and NOTICE sit at the top
     level, as copies of the reactor root's files. -->
<component xmlns="http://maven.apache.org/ASSEMBLY-COMPONENT/2.2.0"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://maven.apache.org/ASSEMBLY-COMPONENT/2.2.0
                               https://maven.apache.org/xsd/assembly-component-2.2.0.xsd">
  <files>
    <file>
      <source>${skillroy.root.dir}/LICENSE</source>
      <outputDirectory>/</outputDirectory>
      <fileMode>0644</fileMode>
    </file>
    <file>
      <source>${skillroy.root.dir}/NOTICE</source>
      <outputDirectory>/</outputDirectory>
      <fileMode>0644</fileMode>
    </file>
  </files>
  <dependencySets>
    <dependencySet>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>ai.skillroy:skillroy-agent-bootstrap</include>
      </includes>
      <useProjectArtifact>false</useProjectArtifact>
      <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
    </dependencySet>
    <dependencySet>
      <outputDirectory>lib</outputDirectory>
      <includes>
        <include>ai.skillroy:skillroy-protocol</include>
        <include>ai.skillroy:skillroy-agent-api</include>
        <include>ai.skillroy:skillroy-agent-core</include>
      </includes>
      <useProjectArtifact>false</useProjectArtifact>
      <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
    </dependencySet>
    <dependencySet>
      <outputDirectory>modules</outputDirectory>
      <includes>
        <include>ai.skillroy:skillroy-agent-swing</include>
        <include>ai.skillroy:skillroy-agent-data</include>
        <include>ai.skillroy:skillroy-agent-web</include>
      </includes>
      <useProjectArtifact>false</useProjectArtifact>
      <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
    </dependencySet>
    <!-- Phase 6 (phase6-contracts.md 2.1, D114; BW): optional/, never scanned; a jar there loads only when the agent
         option optionalModules names its file stem. The Byteman module and the sys jar it appends to the system
         class path; Byteman itself is the user's and never here (B8). -->
    <dependencySet>
      <outputDirectory>optional</outputDirectory>
      <includes>
        <include>ai.skillroy:skillroy-agent-byteman</include>
        <include>ai.skillroy:skillroy-agent-byteman-sys</include>
      </includes>
      <useProjectArtifact>false</useProjectArtifact>
      <outputFileNameMapping>${artifact.artifactId}.${artifact.extension}</outputFileNameMapping>
    </dependencySet>
  </dependencySets>
</component>
