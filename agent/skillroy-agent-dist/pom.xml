<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-agent-dist</artifactId>
  <packaging>pom</packaging>
  <name>skillroy-agent-dist</name>
  <description>
    Assembles the agent home: target/skillroy-agent/ (directory) and target/skillroy-agent.zip, with versionless
    jar names. The zip is also attached as this module's artifact (type zip, no classifier).
  </description>

  <properties>
    <maven.compiler.release>8</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-bootstrap</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-protocol</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-api</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-core</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-swing</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-data</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-web</artifactId>
    </dependency>
    <!-- Phase 6 (phase6-contracts.md 2.1): the spy jar at the home's root, and the optional hooks module under
         optional/ (one jar, Byte Buddy relocated and merged in; nothing of its tree is needed here). -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-spy</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-hooks</artifactId>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Phase 6 (phase6-contracts.md 2.1; BW): the optional Byteman module and its sys jar feed the optional/ set. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-byteman</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-byteman-sys</artifactId>
    </dependency>
    <!-- Byteman (LGPL-2.1-or-later) at test scope only (D134): BytemanIT takes the jar's path from this test class
         path; nothing of it is in the home (docs/licence-audit.md 5). -->
    <dependency>
      <groupId>org.jboss.byteman</groupId>
      <artifactId>byteman</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Packaging pom has no compile bindings: compile the integration tests (Java 8) explicitly. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>it-test-compile</id>
            <phase>test-compile</phase>
            <goals>
              <goal>testCompile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- *IT classes launch child JVMs against target/skillroy-agent after the package phase assembled it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- DistributionContentIT compares the licence files in the home with the root ones. -->
            <skillroy.root.dir>${skillroy.root.dir}</skillroy.root.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <finalName>skillroy-agent</finalName>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
        <executions>
          <!-- target/skillroy-agent/ : the agent home as a directory, used directly by tests in the reactor. -->
          <execution>
            <id>agent-home-dir</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/assembly/agent-home-dir.xml</descriptor>
              </descriptors>
              <attach>false</attach>
            </configuration>
          </execution>
          <!-- target/skillroy-agent.zip : the same content under a top-level skillroy-agent/ directory. -->
          <execution>
            <id>agent-home-zip</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/assembly/agent-home-zip.xml</descriptor>
              </descriptors>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
