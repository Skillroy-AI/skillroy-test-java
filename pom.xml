  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
          <executions>
            <!-- Every jar carries the project's LICENSE and NOTICE as META-INF/LICENSE and META-INF/NOTICE. This is an
                 execution of its own (not a <resources> entry) so that modules which declare resources of their own
                 get the files too. The source is the reactor root (skillroy.root.dir). The fixed
                 project.build.outputTimestamp is applied to the jar entries by maven-jar-plugin. -->
            <execution>
              <id>copy-legal-files</id>
              <phase>process-resources</phase>
              <goals>
                <goal>copy-resources</goal>
              </goals>
              <configuration>
                <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                <resources>
                  <resource>
                    <directory>${skillroy.root.dir}</directory>
                    <includes>
                      <include>LICENSE</include>
                      <include>NOTICE</include>
                    </includes>
                  </resource>
                </resources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <testRelease>${maven.compiler.release}</testRelease>
            <encoding>${project.build.sourceEncoding}</encoding>
            <compilerArgs>
              <!-- Release 8 is obsolete on current JDKs; the warning is expected and suppressed. -->
              <arg>-Xlint:-options</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <argLine>-Djava.awt.headless=${skillroy.headless} ${skillroy.test.extraArgLine}</argLine>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
          <configuration>
            <argLine>-Djava.awt.headless=${skillroy.headless} ${skillroy.test.extraArgLine}</argLine>
            <trimStackTrace>false</trimStackTrace>
          </configuration>
          <executions>
            <execution>
              <id>integration-tests</id>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>${maven-assembly-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven-dependency-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[${skillroy.build.minMaven},)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[${skillroy.build.minJava},)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The web host samples (phase4-contracts.md, sections 9 and 11): built only with -Pjcef, so that a build without
         the profile neither sees the modules nor needs JCEF's natives (about 150 MB per platform) in the Maven cache.
         skillroy.jcef.platform selects the natives artifact (linux-amd64, linux-arm64, macosx-arm64, ...); set it on
         the command line for another platform, e.g. -Dskillroy.jcef.platform=linux-arm64 for an arm64 image. -->
    <profile>
      <id>jcef</id>
      <properties>
        <skillroy.jcef.platform>linux-amd64</skillroy.jcef.platform>
        <!-- jcefmaven 152.0.6 wraps java-cef 17e805a, CEF 152.0.6 and Chromium 152.0.7977.83; jcef-api and the natives
             are versioned by that release tag, not by the jcefmaven number. -->
        <jcefmaven.version>152.0.6</jcefmaven.version>
        <jcef.tag>jcef-17e805a+cef-152.0.6+g708dc14+chromium-152.0.7977.83</jcef.tag>
      </properties>
      <modules>
        <module>samples/skillroy-sample-web-host</module>
        <module>samples/skillroy-sample-web-host-agent</module>
        <module>samples/skillroy-sample-web-host-scenarios</module>
      </modules>
      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>ai.skillroy</groupId>
            <artifactId>skillroy-sample-web-host</artifactId>
            <version>${project.version}</version>
          </dependency>
          <dependency>
            <groupId>ai.skillroy</groupId>
            <artifactId>skillroy-sample-web-host-agent</artifactId>
            <version>${project.version}</version>
          </dependency>
          <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcefmaven</artifactId>
            <version>${jcefmaven.version}</version>
          </dependency>
          <dependency>
            <groupId>me.friwi</groupId>
            <artifactId>jcef-natives-${skillroy.jcef.platform}</artifactId>
            <version>${jcef.tag}</version>
          </dependency>
        </dependencies>
      </dependencyManagement>
    </profile>
    <!-- Pass -Dskillroy.it.targetJava=<java executable> through to test JVMs, only when it is set. -->
    <profile>
      <id>pass-it-target-java</id>
      <activation>
        <property>
          <name>skillroy.it.targetJava</name>
        </property>
      </activation>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <systemPropertyVariables>
                  <skillroy.it.targetJava>${skillroy.it.targetJava}</skillroy.it.targetJava>
                </systemPropertyVariables>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-failsafe-plugin</artifactId>
              <configuration>
                <systemPropertyVariables>
                  <skillroy.it.targetJava>${skillroy.it.targetJava}</skillroy.it.targetJava>
                </systemPropertyVariables>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <!-- Pass -Dskillroy.agent.home=<dir> through to test JVMs, only when it is set. -->
    <profile>
      <id>pass-agent-home</id>
      <activation>
        <property>
          <name>skillroy.agent.home</name>
        </property>
      </activation>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <systemPropertyVariables>
                  <skillroy.agent.home>${skillroy.agent.home}</skillroy.agent.home>
                </systemPropertyVariables>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-failsafe-plugin</artifactId>
              <configuration>
                <systemPropertyVariables>
                  <skillroy.agent.home>${skillroy.agent.home}</skillroy.agent.home>
                </systemPropertyVariables>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <!-- The live tests of phase5-contracts.md 15.3, which call the live Claude API and spend money (2.3, D111): only
         with -Pinference-live, never activated by the environment (a profile on the key alone would make every verify
         on a machine with a key call a model), never in CI. It sets skillroy.inference.live=true for the test JVMs.
         The live tests are failsafe classes named *LiveIT, compiled and run by every verify, each beginning with two
         assumptions: this property ("the profile inference-live is not active") and ANTHROPIC_API_KEY in the
         environment, which the forked test JVM inherits ("no model key"); without the profile, or with it and without
         the key, they are reported skipped, never failed. -->
    <profile>
      <id>inference-live</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <systemPropertyVariables>
                  <skillroy.inference.live>true</skillroy.inference.live>
                </systemPropertyVariables>
              </configuration>
            </plugin>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-failsafe-plugin</artifactId>
              <configuration>
                <systemPropertyVariables>
                  <skillroy.inference.live>true</skillroy.inference.live>
                </systemPropertyVariables>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
    <!-- Refreshes the committed recordings of phase5-contracts.md 4.2 from the live API, a maintainer's task that needs
         the key (2.3, D111): only with -Pinference-record, never activated by the environment. It sets
         skillroy.inference.record=true, the property the record route's live test assumes ("the profile
         inference-record is not active", then "no model key"), and skillroy.inference.record.overwrite=true, which
         lets a recording gateway replace a recording that exists (RecordingGateway.OVERWRITE_PROPERTY). -->
    <profile>
      <id>inference-record</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.apache.maven.plugins</groupId>
              <artifactId>maven-surefire-plugin</artifactId>
              <configuration>
                <systemPropertyVariables>
                  <skillroy.inference.record>true</skillroy.inference.record>
                  <skillroy.inference.record.overwrite>true</skillroy.inference.record.overwrite>
                </systemPropertyVariables>
              </configuration>
            </plugin>
