  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Reproducible builds: fixed timestamp for every archive entry. -->
    <project.build.outputTimestamp>2026-10-01T00:00:00Z</project.build.outputTimestamp>

    <!-- The reactor root (home of LICENSE and NOTICE) as seen from a module: every module sits two directories below
         it, which is also what its <relativePath>../../pom.xml</relativePath> says. -->
    <skillroy.root.dir>${project.basedir}/../..</skillroy.root.dir>

    <!-- Every module sets this explicitly: 8 for agent-side modules, 25 for controller-side modules. -->
    <maven.compiler.release>25</maven.compiler.release>

    <!-- Test JVM settings. Tests that need a display run with -Dskillroy.headless=false under ci/run-in-linux.sh. -->
    <skillroy.headless>true</skillroy.headless>
    <!-- Extra test JVM arguments a module or a command line may add without replacing the argLine. -->
    <skillroy.test.extraArgLine></skillroy.test.extraArgLine>

    <!-- Library versions. -->
    <jackson.version>2.22.3</jackson.version>
    <hsqldb.version>2.7.4</hsqldb.version>
    <junit.version>5.14.4</junit.version>
    <!-- Phase 5 (phase5-contracts.md 2.2, decision D88): the Anthropic Java SDK on its current 2.x line, MIT; the
         newest on Maven Central on 2026-10-08. It brings OkHttp, Okio, Kotlin's standard library, the Jackson jdk8,
         jsr310 and Kotlin modules and the victools schema generator; audited in docs/licence-audit.md section 5. -->
    <anthropic-java.version>2.70.0</anthropic-java.version>
    <!-- JSqlParser: the 5.4 line has no patch release; dual LGPL-2.1 / Apache-2.0, taken under Apache-2.0. -->
    <jsqlparser.version>5.4</jsqlparser.version>
    <!-- Kotlin's standard library and reflection at one version: the SDK asks for 1.9 and the Jackson Kotlin module of
         jackson.version for 2.1.21 (kotlin-reflect 2.1.21 needs the 2.1 standard library). -->
    <kotlin.version>2.1.21</kotlin.version>
    <!-- The MCP Java SDK (phase5-contracts.md 2.2, D88): mcp-core and the Jackson 2 JSON module, MIT, specification
         2025-11-25; not the convenience artifact 'mcp', which adds the Jackson 3 module and so a second Jackson. It
         brings reactor-core, reactive-streams, slf4j-api and json-schema-validator (skillroy-mcp only). -->
    <mcp-sdk.version>2.0.1</mcp-sdk.version>
    <!-- SLF4J at the 2.x version the MCP SDK and the Anthropic SDK's tree bring (slf4j-api 2.0.16), MIT. The CLI adds
         the no-operation provider at the same version, so that the API's "no providers" notice does not print. -->
    <slf4j.version>2.0.16</slf4j.version>

    <!-- Plugin versions. -->
    <maven-assembly-plugin.version>3.8.0</maven-assembly-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-dependency-plugin.version>3.11.0</maven-dependency-plugin.version>
    <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>

    <!-- Build environment required by the enforcer. -->
    <skillroy.build.minMaven>3.9</skillroy.build.minMaven>
    <skillroy.build.minJava>25</skillroy.build.minJava>
  </properties>

