<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-inference</artifactId>
  <name>skillroy-inference</name>
  <description>
    The AI layer (phase5-contracts.md): the inference gateway SPI and its Claude, recorded and scripted gateways, the
    prompt mask and catalogue, SqlGuard, the tier (b) resolver contributed to a bind, budgets and the cost ledger
    writer, and the projection of primitives and verbs as tools. Controller side only: nothing of it reaches a target
    JVM.
  </description>

  <properties>
    <!-- Controller side: Java 25. -->
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- The resolution SPI it contributes to (ResolverContributor, D70), the codec, Schemas and the engine's types. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-scenario</artifactId>
    </dependency>
    <!-- Data channels, the masks and the strict YAML reader. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-data</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-controller</artifactId>
    </dependency>
    <!-- Json (canonical JSON for fingerprints and recordings), SecretKeys, Rows, PrimitiveDescriptor. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-protocol</artifactId>
    </dependency>
    <!-- SqlGuard's parser (phase5-contracts.md 5.3; spike BS6). -->
    <dependency>
      <groupId>com.github.jsqlparser</groupId>
      <artifactId>jsqlparser</artifactId>
    </dependency>
    <!-- ClaudeGateway (phase5-contracts.md 4.1; spike BS13). -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The guard's HSQLDB accept corpus runs on it, and the resolver's tests read through a JDBC channel. -->
    <dependency>
      <groupId>org.hsqldb</groupId>
      <artifactId>hsqldb</artifactId>
      <classifier>jdk8</classifier>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- ClaudeGatewayLiveIT, the live tests of phase5-contracts.md 15.3 items 1 and 2: run by every verify and
           skipped without the profile inference-live or without the key (2.3). Executions (integration-test, verify)
           and argLine come from the parent's pluginManagement. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
