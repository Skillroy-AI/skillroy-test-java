<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-cdp</artifactId>
  <name>skillroy-cdp</name>
  <description>
    The CDP path of the web verbs: Playwright connectOverCDP behind a liveness probe and an external deadline, page
    mapping by target id and tracing. Optional: a suite puts this jar on its class path and the executor finds the
    path through ServiceLoader&lt;WebPath&gt; (phase4-contracts.md section 5, D49).
  </description>

  <properties>
    <!-- Controller side: Java 25. -->
    <maven.compiler.release>25</maven.compiler.release>
    <!-- The one third-party dependency the contract names for this module (phase4-contracts.md section 5). -->
    <playwright.version>1.63.0</playwright.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-scenario</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-controller</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-protocol</artifactId>
    </dependency>
    <!-- Brings the driver (Node.js and the Playwright package, about 194 MB with every platform's binary); the driver
         is extracted only when a CdpAttach connects, never by the unit tests of this module. -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- No unit test may start the Playwright driver (its extraction alone writes about 140 MB): the default
               PlaywrightFactory refuses in a JVM with this property, and NoPlaywrightInUnitTestsTest checks it. -->
          <systemPropertyVariables>
            <skillroy.cdp.noDriver>true</skillroy.cdp.noDriver>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
