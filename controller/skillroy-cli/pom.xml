<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-cli</artifactId>
  <name>skillroy-cli</name>
  <description>
    Command line front end: list JVMs, attach, inspect, call primitives, compile and run scenarios. Assembles
    target/skillroy-cli/ (bin/skillroy plus lib/*.jar) and target/skillroy-cli.zip.
  </description>

  <properties>
    <!-- Controller side: Java 25. -->
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Where the integration tests find the real agent home (unpacked from skillroy-agent-dist). -->
    <skillroy.cli.it.agentHome>${project.build.directory}/it-agent-home/skillroy-agent</skillroy.cli.it.agentHome>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-protocol</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-controller</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-scenario</artifactId>
    </dependency>
    <!-- credentials.yaml for run and resolve (the credentials option). -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-data</artifactId>
    </dependency>
    <!-- Phase 5 (phase5-contracts.md 2.1, 2.6): the AI layer's commands (re-resolve, author, triage, session) and the
         tier (b) resolver a live or approve bind finds through ServiceLoader; the MCP server of 'skillroy mcp'. They
         bring the Anthropic Java SDK, JSqlParser and the MCP Java SDK with their trees into lib/ (THIRD-PARTY.txt). -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-inference</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-mcp</artifactId>
    </dependency>
    <!-- Phase 6 (phase6-contracts.md 2.1, 2.6, D140): OpenTelemetry export, bundled so that the zip's - -telemetry works
         as shipped; the OpenTelemetry jars it brings are in lib/ (THIRD-PARTY.txt). Found through ServiceLoader only
         when an exporter is named: without - -telemetry no OpenTelemetry class loads. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-telemetry</artifactId>
    </dependency>
    <!-- slf4j-api (in the SDKs' trees) finds no provider and prints a notice on stderr once; the no-operation provider
         keeps the CLI's stderr to its own messages (phase5-contracts.md 9.3, as built). Runtime only. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The agent home the attach integration test unpacks (below). Declared so that the reactor builds the
         distribution first: a build of this module alone (-pl ... -am) would otherwise unpack whatever zip the local
         repository holds, possibly a stale one. Not used on the class path. -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-agent-dist</artifactId>
      <type>zip</type>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>ai.skillroy.testjava.cli.Main</mainClass>
              <!-- Implementation-Version, printed by the CLI's version option. -->
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <configuration>
          <finalName>skillroy-cli</finalName>
          <appendAssemblyId>false</appendAssemblyId>
          <!-- Build outputs only: attaching a classifier-less zip would replace this module's jar artifact. -->
          <attach>false</attach>
        </configuration>
        <executions>
          <!-- target/skillroy-cli/ : bin/skillroy and lib/*.jar, runnable in place. -->
          <execution>
            <id>cli-dir</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/assembly/cli-dir.xml</descriptor>
              </descriptors>
            </configuration>
          </execution>
          <!-- target/skillroy-cli.zip : the same content under a top-level skillroy-cli/ directory. -->
          <execution>
            <id>cli-zip</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/assembly/cli-zip.xml</descriptor>
              </descriptors>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The attach integration test loads the real agent home into a child JVM. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>it-agent-home</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>ai.skillroy</groupId>
                  <artifactId>skillroy-agent-dist</artifactId>
                  <version>${project.version}</version>
                  <type>zip</type>
                  <outputDirectory>${project.build.directory}/it-agent-home</outputDirectory>
                </artifactItem>
              </artifactItems>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- *IT classes run the assembled bin/skillroy after the package phase. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <skillroy.cli.it.dist>${project.build.directory}/skillroy-cli</skillroy.cli.it.dist>
            <skillroy.cli.it.zip>${project.build.directory}/skillroy-cli.zip</skillroy.cli.it.zip>
            <skillroy.cli.it.agentHome>${skillroy.cli.it.agentHome}</skillroy.cli.it.agentHome>
            <!-- DistributionNoticesIT compares the licence files in the distribution with the root ones. -->
            <skillroy.root.dir>${skillroy.root.dir}</skillroy.root.dir>
          </systemPropertyVariables>
          <!-- As for the unit tests: the launched CLI must not find a developer's own credentials, nor a model key. -->
          <excludedEnvironmentVariables>
            <param>SKILLROY_CREDENTIALS</param>
            <param>ANTHROPIC_API_KEY</param>
            <param>ANTHROPIC_WORKSPACE_ID</param>
          </excludedEnvironmentVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- run and resolve locate credentials.yaml through this variable too: a developer's own must not reach
               the tests, which name their files with the credentials option. The model key and its workspace id
               neither: the tests that need a key give a child JVM a dummy one, and the others assert the
               behaviour without one (phase5-contracts.md 4.4, 15.1 item 16). -->
          <excludedEnvironmentVariables>
            <param>SKILLROY_CREDENTIALS</param>
            <param>ANTHROPIC_API_KEY</param>
            <param>ANTHROPIC_WORKSPACE_ID</param>
          </excludedEnvironmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
