<!-- CLI distribution layout, shared by the directory and zip assemblies: bin/skillroy (POSIX sh launcher, executable),
     lib/ with this module's jar and its runtime dependencies, and at the top level LICENSE and NOTICE (copies of the
     reactor root's files) and THIRD-PARTY.txt (the redistributed third-party jars; a test keeps it in step with lib/).
     The third-party jars are copied unmodified: the notices that travel inside them must stay intact. -->
<component xmlns="http://maven.apache.org/ASSEMBLY-COMPONENT/2.2.0"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://maven.apache.org/ASSEMBLY-COMPONENT/2.2.0
                               https://maven.apache.org/xsd/assembly-component-2.2.0.xsd">
  <files>
    <file>
      <source>${skillroy.root.dir}/LICENSE</source>
      <outputDirectory>/</outputDirectory>
      <fileMode>0644</fileMode>
    </file>
    <file>
      <source>${skillroy.root.dir}/NOTICE</source>
      <outputDirectory>/</outputDirectory>
      <fileMode>0644</fileMode>
    </file>
    <file>
      <source>src/main/dist/THIRD-PARTY.txt</source>
      <outputDirectory>/</outputDirectory>
      <fileMode>0644</fileMode>
      <lineEnding>unix</lineEnding>
    </file>
    <file>
      <source>src/main/sh/skillroy</source>
      <outputDirectory>bin</outputDirectory>
      <fileMode>0755</fileMode>
      <lineEnding>unix</lineEnding>
    </file>
  </files>
  <dependencySets>
    <dependencySet>
      <outputDirectory>lib</outputDirectory>
      <useProjectArtifact>true</useProjectArtifact>
      <scope>runtime</scope>
      <fileMode>0644</fileMode>
    </dependencySet>
  </dependencySets>
</component>
