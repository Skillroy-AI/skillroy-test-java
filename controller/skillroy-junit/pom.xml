<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-junit</artifactId>
  <name>skillroy-junit</name>
  <description>
    JUnit 5 glue: one dynamic test per scenario.
  </description>

  <properties>
    <!-- Controller side: Java 25. -->
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-scenario</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Runs a test factory through the JUnit Platform to check how its outcomes are reported. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Implementation-Version: the service version the JUnit glue's telemetry reports (phase6-contracts.md 10.3). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The glue locates credentials.yaml through this variable too: a developer's own must not reach the
               tests (they name their files through the system property, which they restore). Nor the model key:
               the inference settings' default gateway and the "key not set" refusal depend on it
               (phase5-contracts.md 4.4). -->
          <excludedEnvironmentVariables>
            <param>SKILLROY_CREDENTIALS</param>
            <param>ANTHROPIC_API_KEY</param>
            <param>ANTHROPIC_WORKSPACE_ID</param>
          </excludedEnvironmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
