<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.skillroy</groupId>
    <artifactId>skillroy-test-java-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>skillroy-vision</artifactId>
  <name>skillroy-vision</name>
  <description>
    The vision bolt-on of interactive sessions (phase7-contracts.md 6): the loop's tiers V1-V3 through the session
    service's SessionTools seam and its facade, the custom tools and the Claude computer toolset's adapter, grounding by
    hit-test, the recorder that turns a model's action into the step that will be replayed, visual questions, the
    scenario player of aiAct and aiExpect, the captures directory and the contributor of inference.vision. Optional at
    run time (found through ServiceLoader); controller only: nothing of it enters a target JVM. No third-party
    dependency (image work is java.awt.image and javax.imageio).
  </description>

  <properties>
    <!-- Controller side: Java 25. -->
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-inference</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-scenario</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-controller</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-protocol</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-data</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- FakeAgentConnection, ToyPack and the session fixtures (phase7-contracts.md 6.1, 2.1: the scenario test-jar). -->
    <dependency>
      <groupId>ai.skillroy</groupId>
      <artifactId>skillroy-scenario</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- A developer's own model key or credentials must not reach the tests (no test needs a key). -->
          <excludedEnvironmentVariables>
            <param>SKILLROY_CREDENTIALS</param>
            <param>ANTHROPIC_API_KEY</param>
            <param>ANTHROPIC_WORKSPACE_ID</param>
          </excludedEnvironmentVariables>
          <!-- The marks are drawn with java.awt.image: never a display. -->
          <systemPropertyVariables>
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
